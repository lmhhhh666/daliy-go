{
  "name": "personal-schedule-app",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "个人课表计划 - 支持截图 OCR 导入、自动排程与完成统计的 PWA 移动应用",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "cap:sync": "npm run build && npx cap sync",
    "cap:add:android": "npm run build && npx cap add android && npx cap sync",
    "cap:add:ios": "npm run build && npx cap add ios && npx cap sync"
  },
  "dependencies": {
    "@capacitor/core": "^6.2.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@mui/icons-material": "^6.4.0",
    "@mui/material": "^6.4.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tesseract.js": "^5.1.1"
  },
  "devDependencies": {
    "@capacitor/android": "^6.2.3",
    "@capacitor/cli": "^6.2.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vite": "^6.0.7",
    "vite-plugin-pwa": "^0.21.1"
  }
}
